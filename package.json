{
  "name": "@jmlweb/skills-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "scripts": {
    "postinstall": "simple-git-hooks",
    "build": "turbo run build",
    "test": "turbo run test test:scripts",
    "lint:skills": "node scripts/lint-skills.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "version:sync": "node scripts/version-sync.js",
    "version:check": "node scripts/check-version-consistency.mjs",
    "backlog:check": "node scripts/check-backlog-integrity.mjs",
    "names:check": "node scripts/check-reserved-names.mjs",
    "eval:live": "node scripts/eval-live.mjs",
    "sandbox:prune-tests": "node scripts/sandbox-prune-tests.mjs",
    "sandbox:deslop": "node scripts/sandbox-deslop.mjs",
    "sandbox:harden": "node scripts/sandbox-harden.mjs",
    "sandbox:kickstart": "node scripts/sandbox-kickstart.mjs",
    "sandbox:readme-media": "node scripts/sandbox-readme-media.mjs",
    "sandbox:github-backend": "node scripts/sandbox-github-backend.mjs"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.10"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs"
  }
}
