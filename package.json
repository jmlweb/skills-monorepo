{
  "name": "@jmlweb/skills-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "type": "module",
  "scripts": {
    "postinstall": "simple-git-hooks",
    "build": "turbo run build",
    "test": "turbo run test test:scripts",
    "lint:skills": "node scripts/lint-skills.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "version:sync": "node scripts/version-sync.js",
    "version:check": "node scripts/check-version-consistency.mjs",
    "backlog:check": "node scripts/check-backlog-integrity.mjs",
    "names:check": "node scripts/check-reserved-names.mjs"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.11.1",
    "turbo": "^2.5.0"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs"
  }
}
