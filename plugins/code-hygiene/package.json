{
  "name": "@jmlweb/code-hygiene",
  "version": "1.0.0",
  "description": "Code hygiene tools for Claude Code: test pruning, hardening, deslop, UI verification, docs audits and README media",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "code-hygiene": "./dist/bin/code-hygiene.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bump": "bash ../../scripts/bump-plugin.sh code-hygiene"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "tests",
    "documentation",
    "quality"
  ],
  "author": "jmlweb (https://github.com/jmlweb)",
  "homepage": "https://github.com/jmlweb/skills-monorepo/tree/main/plugins/code-hygiene",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmlweb/skills-monorepo.git",
    "directory": "plugins/code-hygiene"
  },
  "bugs": {
    "url": "https://github.com/jmlweb/skills-monorepo/issues"
  },
  "license": "MIT"
}
