{
  "name": "@jmlweb/atlassian-polish",
  "version": "0.8.0",
  "description": "Rewrite Jira issues and Confluence pages into scannable, human-friendly content",
  "type": "module",
  "bin": {
    "atlassian-polish": "./dist/bin/atlassian-polish.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bump": "bash ../../scripts/bump-plugin.sh atlassian-polish"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "jira",
    "confluence",
    "atlassian"
  ],
  "author": "jmlweb (https://github.com/jmlweb)",
  "homepage": "https://github.com/jmlweb/skills-monorepo/tree/main/plugins/atlassian-polish",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmlweb/skills-monorepo.git",
    "directory": "plugins/atlassian-polish"
  },
  "bugs": {
    "url": "https://github.com/jmlweb/skills-monorepo/issues"
  },
